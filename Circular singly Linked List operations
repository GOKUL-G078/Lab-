
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* head = nullptr;

// Insert at end
void insert(int x) {
    Node* n = new Node;

    n->data = x;

    if (head == nullptr) {
        head = n;
        n->next = head;
    } else {
        Node* temp = head;

        while (temp->next != head) {
            temp = temp->next;
        }

        temp->next = n;
        n->next = head;
    }
}


void deleteNode(int x) {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head;
    Node* prev = nullptr;

    do {
        if (temp->data == x) {
            break;
        }

        prev = temp;
        temp = temp->next;

    } while (temp != head);

    if (temp->data != x) {
        cout << "Element not found\n";
        return;
    }

    if (temp == head && temp->next == head) {
        head = nullptr;
    }
    else if (temp == head) {
        Node* last = head;

        while (last->next != head) {
            last = last->next;
        }

        head = head->next;
        last->next = head;
    }
    else {
        prev->next = temp->next;
    }

    delete temp;
    cout << "Node deleted\n";
}
void display() {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head;

    do {
        cout << temp->data << " ";
        temp = temp->next;
    } while (temp != head);

    cout << endl;
}

int main() {
    int choice, x;

    do {
        cout << "\n1. Insert";
        cout << "\n2. Delete";
        cout << "\n3. Display";
        cout << "\n4. Exit";

        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                insert(x);
                break;

            case 2:
                cout << "Enter value to delete: ";
                cin >> x;
                deleteNode(x);
                break;

            case 3:
                display();
                break;

            case 4:
                cout << "Exit";
                break;

            default:
                cout << "Invalid choice";
        }

    } while (choice != 4);

    return 0;
}
