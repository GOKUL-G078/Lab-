
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

Node* head = nullptr;
void insert(int x) {
    Node* n = new Node;

    n->data = x;

    if (head == nullptr) {
        head = n;
        n->next = head;
        n->prev = head;
    } else {
        Node* last = head->prev;

        n->next = head;
        n->prev = last;

        last->next = n;
        head->prev = n;
    }
}
void deleteNode(int x) {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head;

    do {
        if (temp->data == x) {
            break;
        }

        temp = temp->next;

    } while (temp != head);

    if (temp->data != x) {
        cout << "Element not found\n";
        return;
    }

    if (temp->next == temp) {
        head = nullptr;
    } else {
        temp->prev->next = temp->next;
        temp->next->prev = temp->prev;

        if (temp == head) {
            head = temp->next;
        }
    }

    delete temp;
    cout << "Node deleted\n";
}
void displayForward() {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head;

    do {
        cout << temp->data << " ";
        temp = temp->next;
    } while (temp != head);

    cout << endl;
}
void displayBackward() {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head->prev;

    do {
        cout << temp->data << " ";
        temp = temp->prev;
    } while (temp != head->prev);

    cout << endl;
}

int main() {
    int choice, x;

    do {
        cout << "\n1. Insert";
        cout << "\n2. Delete";
        cout << "\n3. Display Forward";
        cout << "\n4. Display Backward";
        cout << "\n5. Exit";

        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                insert(x);
                break;

            case 2:
                cout << "Enter value to delete: ";
                cin >> x;
                deleteNode(x);
                break;

            case 3:
                displayForward();
                break;

            case 4:
                displayBackward();
                break;

            case 5:
                cout << "Exit";
                break;

            default:
                cout << "Invalid choice";
        }

    } while (choice != 5);

    return 0;
}
