
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

Node* head = nullptr;

// Insert at beginning
void insertBeginning(int x) {
    Node* n = new Node;

    n->data = x;
    n->prev = nullptr;
    n->next = head;

    if (head != nullptr) {
        head->prev = n;
    }

    head = n;
}

// Insert at end
void insertEnd(int x) {
    Node* n = new Node;

    n->data = x;
    n->next = nullptr;

    if (head == nullptr) {
        n->prev = nullptr;
        head = n;
        return;
    }

    Node* temp = head;

    while (temp->next != nullptr) {
        temp = temp->next;
    }

    temp->next = n;
    n->prev = temp;
}

// Delete a node
void deleteNode(int x) {
    Node* temp = head;

    while (temp != nullptr && temp->data != x) {
        temp = temp->next;
    }

    if (temp == nullptr) {
        cout << "Element not found\n";
        return;
    }

    if (temp->prev != nullptr) {
        temp->prev->next = temp->next;
    } else {
        head = temp->next;
    }

    if (temp->next != nullptr) {
        temp->next->prev = temp->prev;
    }

    delete temp;
    cout << "Node deleted\n";
}

// Display forward
void displayForward() {
    Node* temp = head;

    cout << "Forward: ";

    while (temp != nullptr) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
}

// Display backward
void displayBackward() {
    if (head == nullptr) {
        cout << "List is empty\n";
        return;
    }

    Node* temp = head;

    while (temp->next != nullptr) {
        temp = temp->next;
    }

    cout << "Backward: ";

    while (temp != nullptr) {
        cout << temp->data << " ";
        temp = temp->prev;
    }

    cout << endl;
}

int main() {
    int choice, x;

    do {
        cout << "\n1. Insert Beginning";
        cout << "\n2. Insert End";
        cout << "\n3. Delete";
        cout << "\n4. Display Forward";
        cout << "\n5. Display Backward";
        cout << "\n6. Exit";

        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                insertBeginning(x);
                break;

            case 2:
                cout << "Enter value: ";
                cin >> x;
                insertEnd(x);
                break;

            case 3:
                cout << "Enter value to delete: ";
                cin >> x;
                deleteNode(x);
                break;

            case 4:
                displayForward();
                break;

            case 5:
                displayBackward();
                break;

            case 6:
                cout << "Exit";
                break;

            default:
                cout << "Invalid choice";
        }

    } while (choice != 6);

    return 0;
}
