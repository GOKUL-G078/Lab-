
#include <iostream>
#include <string>
using namespace std;

struct Node {
    string song;
    Node* next;
};

Node* head = nullptr;
void insert(string name) {
    Node* n = new Node;

    n->song = name;
    n->next = nullptr;

    if (head == nullptr) {
        head = n;
    } else {
        Node* temp = head;

        while (temp->next != nullptr) {
            temp = temp->next;
        }

        temp->next = n;
    }
}
void display() {
    Node* temp = head;

    while (temp != nullptr) {
        cout << temp->song << " -> ";
        temp = temp->next;
    }

    cout << "NULL\n";
}
void sortPlaylist() {
    Node* i;
    Node* j;
    string temp;

    for (i = head; i != nullptr; i = i->next) {
        for (j = i->next; j != nullptr; j = j->next) {

            if (i->song > j->song) {
                temp = i->song;
                i->song = j->song;
                j->song = temp;
            }
        }
    }
}

int main() {
    int n;
    string name;

    cout << "Enter number of songs: ";
    cin >> n;

    cin.ignore();

    for (int i = 0; i < n; i++) {
        cout << "Enter song name: ";
        getline(cin, name);

        insert(name);
    }

    cout << "\nOriginal Playlist:\n";
    display();

    sortPlaylist();

    cout << "\nSorted Playlist:\n";
    display();

    return 0;
}
