
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* head = nullptr;
void insert(int x) {
    Node* n = new Node;

    n->data = x;
    n->next = nullptr;

    if (head == nullptr) {
        head = n;
    } else {
        Node* temp = head;

        while (temp->next != nullptr) {
            temp = temp->next;
        }

        temp->next = n;
    }
}
void secondLast() {
    if (head == nullptr || head->next == nullptr) {
        cout << "Second last node does not exist";
        return;
    }

    Node* temp = head;

    while (temp->next->next != nullptr) {
        temp = temp->next;
    }

    cout << "Second last node: " << temp->data;
}

int main() {
    int n, x;

    cout << "Enter number of nodes: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        cout << "Enter value: ";
        cin >> x;

        insert(x);
    }

    secondLast();

    return 0;
}
