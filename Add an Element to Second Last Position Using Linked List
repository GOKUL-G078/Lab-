
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

Node* head = nullptr;
void insert(int x) {
    Node* n = new Node;

    n->data = x;
    n->next = nullptr;

    if (head == nullptr) {
        head = n;
    } else {
        Node* temp = head;

        while (temp->next != nullptr) {
            temp = temp->next;
        }

        temp->next = n;
    }
}

void insertSecondLast(int x) {
    Node* n = new Node;

    n->data = x;

    if (head == nullptr || head->next == nullptr) {
        n->next = head;
        head = n;
        return;
    }

    Node* temp = head;

    while (temp->next->next != nullptr) {
        temp = temp->next;
    }

    n->next = temp->next;
    temp->next = n;
}
void display() {
    Node* temp = head;

    while (temp != nullptr) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL";
}

int main() {
    int n, x;

    cout << "Enter number of nodes: ";
    cin >> n;

    for (int i = 0; i < n; i++) {
        cout << "Enter value: ";
        cin >> x;

        insert(x);
    }

    cout << "\nOriginal List: ";
    display();

    cout << "\nEnter element to insert: ";
    cin >> x;

    insertSecondLast(x);

    cout << "\nUpdated List: ";
    display();

    return 0;
}
