
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};
void insert(Node*& head, int x) {
    Node* n = new Node;
    n->data = x;
    n->next = nullptr;

    if (head == nullptr) {
        head = n;
        return;
    }

    Node* temp = head;

    while (temp->next != nullptr) {
        temp = temp->next;
    }

    temp->next = n;
}
Node* merge(Node* a, Node* b) {
    Node* result = nullptr;
    Node* tail = nullptr;

    while (a != nullptr && b != nullptr) {
        Node* selected;

        if (a->data <= b->data) {
            selected = a;
            a = a->next;
        } else {
            selected = b;
            b = b->next;
        }

        if (result == nullptr) {
            result = selected;
            tail = selected;
        } else {
            tail->next = selected;
            tail = selected;
        }
    }

    if (a != nullptr)
        tail->next = a;
    else if (b != nullptr)
        tail->next = b;

    return result;
}
{
void display(Node* head) {
    Node* temp = head;

    while (temp != nullptr) {
        cout << temp->data << " ";
        temp = temp->next;
    }

    cout << endl;
}

int main() {
    Node* head1 = nullptr;
    Node* head2 = nullptr;

    int n, x;

    cout << "Enter number of nodes in first list: ";
    cin >> n;

    cout << "Enter sorted elements: ";
    for (int i = 0; i < n; i++) {
        cin >> x;
        insert(head1, x);
    }

    cout << "Enter number of nodes in second list: ";
    cin >> n;

    cout << "Enter sorted elements: ";
    for (int i = 0; i < n; i++) {
        cin >> x;
        insert(head2, x);
    }

    Node* merged = merge(head1, head2);

    cout << "Merged linked list: ";
    display(merged);

    return 0;
}
